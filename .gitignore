# Contribution and brief files carry exact financial figures and personal
# context. They stay local, always; never commit them. Contracts and code are
# tracked; outputs are not.
*/contributions/
*/briefs/*
# The builder and the viewer check live beside the briefs and are code.
!daily-brief/briefs/build.py
!daily-brief/briefs/check-viewer.mjs

# Session state and planning artifacts: synced, never committed (repo convention).
thoughts/

# Its own repository and Sites deployment.
dashboard/prototype/

# Local tool state.
.claude/
.playwright-mcp/
node_modules/
__pycache__/
*.log

.DS_Store

# Watch outputs: newsletter stories and run state, local only.
daily-brief/watch/packets/
daily-brief/watch/overflow/
daily-brief/watch/seen.jsonl
daily-brief/watch/state.json

# Feed store: what the producers found and judged, local only.
feed/items/

# Ideas store: suggestions and their dashboard marks, local only.
ideas/items/
ideas/marks.json

# Routine runs: each routine's runs log, local only; the routine files
# beside it are committed like the registry.
routines/runs/

# Notifications agents raise: a sentence may carry a figure, local only.
/notifications/
