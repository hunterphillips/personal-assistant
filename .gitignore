# Contribution and brief files carry exact financial figures and personal
# context. They stay local, always; never commit them. Contracts and code are
# tracked; outputs are not.
*/contributions/
*/briefs/*
# The builder and the viewer check live beside the briefs and are code.
!daily-brief/briefs/build.py
!daily-brief/briefs/check-viewer.mjs

# Session state and planning artifacts: synced, never committed (repo convention).
thoughts/

# Its own repository and Sites deployment.
dashboard/prototype/

# Local tool state. An agent's skills are code, tracked.
.claude/
!agents/*/.claude/
!agents/*/.claude/skills/
!agents/*/.claude/skills/**
.playwright-mcp/
node_modules/
__pycache__/
*.log

.DS_Store

# What the data root's migration leaves behind in the checkout: the moved
# sources, renamed rather than deleted. They hold the same private data.
*.migrated
*.migrated-*
