#!/bin/sh
# Daily watch contributor. Reads the chosen newsletters from Gmail, extracts
# their stories, triages them against the data root's feed/relevance.md, and
# writes watch/packets/<date>.yaml under the root for the next Daily Brief
# run to pick up. Most days find nothing new, since the five sources are
# weekly.
#
#   contribute [--date YYYY-MM-DD] [--since YYYY-MM-DD] [--dry-run]
#
# Read-only toward Gmail. Writes only under the data root
# (PERSONAL_ASSISTANT_HOME, default ~/.personal-assistant): its watch/, the
# run's feed file (feed/items/<date>-watch.json, filled in by
# feed/bin/enrich); and the logs. The prompts, schemas, and render.py stay
# in the repository.
set -u
unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT

root=/Users/hunterphillips/workspace/personal-assistant
watch_code=$root/daily-brief/watch
data=${PERSONAL_ASSISTANT_HOME:-$HOME/.personal-assistant}
case $data in /*) ;; *) printf 'contribute: PERSONAL_ASSISTANT_HOME must be an absolute path: %s\n' "$data" >&2; exit 2 ;; esac
watch_data=$data/watch
relevance=$data/feed/relevance.md
feed_dir=$data/feed/items
vault=/Users/hunterphillips/workspace/second-brain/notes
claude=/Users/hunterphillips/.local/bin/claude
python3=/usr/bin/python3
jq=/usr/bin/jq
tz=America/Chicago
log_file=/Users/hunterphillips/Library/Logs/daily-brief.log
transcripts=/Users/hunterphillips/Library/Logs/daily-brief
lock_dir=$watch_data/.run.lock

list_model=${WATCH_LIST_MODEL:-haiku}
extract_model=${WATCH_EXTRACT_MODEL:-haiku}
triage_model=${WATCH_TRIAGE_MODEL:-opus}
stage_seconds=${WATCH_STAGE_SECONDS:-480}
parallel=${WATCH_PARALLEL:-4}
triage_seconds=${WATCH_TRIAGE_SECONDS:-600}
enrich_seconds=${WATCH_ENRICH_SECONDS:-180}

# The five senders. The root's feed/relevance.md is the human-readable list;
# this is the query.
senders="swyx@substack.com swyx+ainews@substack.com nashville@axios.com kale@hackernewsletter.com simonw@substack.com"

date=; since=; dry_run=0
while [ $# -gt 0 ]; do
    case $1 in
        --date) date=$2; shift 2 ;;
        --since) since=$2; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        *) printf 'contribute: unknown argument %s\n' "$1" >&2; exit 2 ;;
    esac
done
[ -n "$date" ] || date=$(TZ=$tz /bin/date +%F)
if [ -z "$since" ]; then
    since=$([ -f "$watch_data/state.json" ] && $jq -r '.last_run // empty' "$watch_data/state.json")
    [ -n "$since" ] || since=$(TZ=$tz /bin/date -j -v-14d -f %Y-%m-%d "$date" +%F)
fi

now_iso() { TZ=$tz /bin/date '+%Y-%m-%dT%H:%M:%S%z' | /usr/bin/sed 's/\([0-9][0-9]\)$/:\1/'; }
log() { printf '%s %s\n' "$(now_iso)" "watch $1" >>"$log_file"; }

query="("
for s in $senders; do query="$query from:$s OR"; done
query="${query% OR} ) after:$(printf '%s' "$since" | /usr/bin/tr '-' '/')"

run_limited() {
    limit=$1; shift
    "$@" &
    pid=$!; elapsed=0; timed_out=0
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$elapsed" -ge "$limit" ]; then
            timed_out=1; kill -TERM "$pid" 2>/dev/null; /bin/sleep 5; kill -KILL "$pid" 2>/dev/null; break
        fi
        /bin/sleep 2; elapsed=$((elapsed + 2))
    done
    wait "$pid"; st=$?
    [ "$timed_out" = 1 ] && return 124
    return "$st"
}

# run_session LIMIT CHECK_JQ OUT CMD-STRING: run CMD (a sh -c string writing
# OUT) up to twice, until OUT satisfies the jq expression. Network blips and
# a killed session both look the same from here, so both get one more try.
run_session() {
    limit=$1; check=$2; out=$3; cmd=$4
    tries=0
    while [ "$tries" -lt 2 ]; do
        tries=$((tries + 1))
        run_limited "$limit" sh -c "$cmd"
        $jq -e "$check" "$out" >/dev/null 2>&1 && return 0
        /bin/sleep 15
    done
    return 1
}

if [ "$dry_run" = 1 ]; then
    printf 'watch dry run for %s\n  data root %s\n  since=%s\n  query=%s\n' "$date" "$data" "$since" "$query"
    printf '  list: %s -p --model %s --allowedTools mcp__claude_ai_Gmail__search_threads --output-format json --json-schema schemas/threads.json < prompts/list.md\n' "$claude" "$list_model"
    printf '  extract: one %s session per thread with mcp__claude_ai_Gmail__get_thread, schemas/stories.json, %s at a time, %ss each, one retry\n' "$extract_model" "$parallel" "$stage_seconds"
    printf '  triage: %s, no tools, prompts/triage.md with %s, the two vault priority notes, %s/seen.jsonl (14d), the stories; schemas/triage.json\n' "$triage_model" "$relevance" "$watch_data"
    printf '  render: %s render.py --date %s --since %s --out %s --feed %s -> packets/%s.yaml, overflow/%s.json, seen.jsonl, state.json under --out; %s-watch.json under --feed (kept if present)\n' "$python3" "$date" "$since" "$watch_data" "$feed_dir" "$date" "$date" "$date"
    printf '  enrich: %s feed/bin/enrich %s/%s-watch.json (image from each story page, 4 at a time, 6s each, %ss in all)\n' "$python3" "$feed_dir" "$date" "$enrich_seconds"
    exit 0
fi

# The daemon seeds the criteria into the root from the repo's defaults/ at
# start; a root it has never started on has none.
[ -f "$relevance" ] || { log "exit=1 date=$date reason=no-criteria $relevance"; printf 'contribute: no criteria at %s; start the dashboard once to seed it\n' "$relevance" >&2; exit 1; }
/bin/mkdir -p "$transcripts" && /bin/chmod 700 "$transcripts"
(umask 077 && /bin/mkdir -p "$watch_data/packets" "$watch_data/overflow" "$feed_dir") || exit 1
if ! /bin/mkdir "$lock_dir" 2>/dev/null; then
    if [ -n "$(/usr/bin/find "$lock_dir" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then /bin/rm -rf "$lock_dir"; /bin/mkdir "$lock_dir" || exit 0
    else log "exit=0 date=$date reason=locked"; exit 0; fi
fi
work=$(/usr/bin/mktemp -d "$transcripts/watch-$date.XXXX")
trap '/bin/rm -rf "$lock_dir"' EXIT INT TERM
cd "$root" || exit 1

attempt=0
until /usr/bin/curl -sS --max-time 5 -o /dev/null https://api.anthropic.com 2>/dev/null; do
    attempt=$((attempt + 1)); [ "$attempt" -ge 6 ] && { log "exit=1 date=$date reason=no-network"; exit 1; }; /bin/sleep 10
done

# --- stage 1: list threads --------------------------------------------------
/usr/bin/sed -e "s|{{QUERY}}|$query|g" "$watch_code/prompts/list.md" >"$work/list.md"
if ! run_session "$stage_seconds" '.structured_output.threads | length > 0' "$work/list.json" "\"$claude\" -p --model \"$list_model\" \
    --allowedTools mcp__claude_ai_Gmail__search_threads \
    --output-format json --json-schema \"\$(cat \"$watch_code/schemas/threads.json\")\" \
    <\"$work/list.md\" >\"$work/list.json\" 2>\"$work/list.err\""; then
    # A daily run mostly finds nothing: the five sources are weekly, so an
    # empty listing with no error is a quiet day, not a failure. Only
    # list.md's error field (set when the tool call itself failed, was
    # denied, or was unavailable) or a malformed/missing structured_output
    # counts as a real failure.
    if $jq -e '.structured_output.threads == [] and .structured_output.error == null' "$work/list.json" >/dev/null 2>&1; then
        log "exit=0 date=$date since=$since reason=nothing-new"; exit 0
    fi
    err=$($jq -r '.structured_output.error // .result // ""' "$work/list.json" 2>/dev/null | /usr/bin/head -c 160)
    log "exit=1 date=$date since=$since reason=list-empty-or-failed error=${err:-none}"; /bin/cat "$work/list.err" >&2; exit 1
fi
n_threads=$($jq '.structured_output.threads | length' "$work/list.json")

# --- stage 2: extract stories, one session per thread, in parallel ------------
i=0
$jq -c '.structured_output.threads[]' "$work/list.json" >"$work/threads.jsonl"
while read -r t; do
    [ -n "$t" ] || continue
    i=$((i + 1))
    tid=$(printf '%s' "$t" | $jq -r .id); subj=$(printf '%s' "$t" | $jq -r .subject | /usr/bin/tr '|' '/'); snd=$(printf '%s' "$t" | $jq -r .sender)
    /usr/bin/sed -e "s|{{THREAD_ID}}|$tid|g" -e "s|{{SUBJECT}}|$subj|g" -e "s|{{SENDER}}|$snd|g" "$watch_code/prompts/extract.md" >"$work/extract-$i.md"
    run_session "$stage_seconds" '.structured_output.stories | length > 0' "$work/stories-$i.json" "\"$claude\" -p --model \"$extract_model\" \
        --allowedTools mcp__claude_ai_Gmail__get_thread \
        --output-format json --json-schema \"\$(cat \"$watch_code/schemas/stories.json\")\" \
        <\"$work/extract-$i.md\" >\"$work/stories-$i.json\" 2>\"$work/extract-$i.err\"" &
    [ $((i % parallel)) -eq 0 ] && wait
done <"$work/threads.jsonl"
wait

ok=0; failed=0
: >"$work/stories.txt"
for f in "$work"/stories-*.json; do
    [ -f "$f" ] || continue
    if $jq -e '.structured_output.stories' "$f" >/dev/null 2>&1; then
        ok=$((ok + 1))
        $jq -r '.structured_output as $o | $o.stories[] | "- [\($o.source), \($o.issue_date)] \(.title) — \(.summary) <\(.url)>"' "$f" >>"$work/stories.txt"
    else
        failed=$((failed + 1))
    fi
done
n_stories=$(/usr/bin/grep -c '^- ' "$work/stories.txt" || true)

# --- stage 3: triage ----------------------------------------------------------
cutoff=$(TZ=$tz /bin/date -j -v-14d -f %Y-%m-%d "$date" +%F)
seen_txt=$([ -f "$watch_data/seen.jsonl" ] && $jq -r --arg c "$cutoff" 'select(.date >= $c) | "- [\(.source)] \(.title) <\(.url)>"' "$watch_data/seen.jsonl")
[ -n "$seen_txt" ] || seen_txt="(nothing)"
"$python3" - "$watch_code/prompts/triage.md" "$relevance" "$vault/longterm-priorities.md" "$vault/current-priorities.md" "$work/stories.txt" "$since" "$work/triage.md" "$seen_txt" <<'PY'
import sys
tmpl, rel, lt, cur, stories, since, out, seen = sys.argv[1:9]
r = lambda p: open(p, encoding="utf-8").read()
t = r(tmpl)
for k, v in {"{{RELEVANCE}}": r(rel), "{{LONGTERM}}": r(lt), "{{CURRENT}}": r(cur),
             "{{STORIES}}": r(stories) or "(none)", "{{SINCE}}": since, "{{SEEN}}": seen}.items():
    t = t.replace(k, v)
open(out, "w", encoding="utf-8").write(t)
PY
if ! run_session "$triage_seconds" '.structured_output.items' "$work/triage.json" "\"$claude\" -p --model \"$triage_model\" \
    --tools \"\" --strict-mcp-config \
    --output-format json --json-schema \"\$(cat \"$watch_code/schemas/triage.json\")\" \
    <\"$work/triage.md\" >\"$work/triage.json\" 2>\"$work/triage.err\""; then
    log "exit=1 date=$date reason=triage-failed threads=$n_threads stories=$n_stories result=$($jq -r '.result // ""' "$work/triage.json" 2>/dev/null | /usr/bin/head -c 120)"; exit 1
fi

status=ok; note=
[ "$failed" -gt 0 ] && { status=degraded; note="$ok of $n_threads issues since $since were read; $failed could not be extracted. "; }
"$python3" "$watch_code/render.py" --date "$date" --since "$since" --out "$watch_data" --feed "$feed_dir" --envelope "$work/triage.json" --threads "$n_threads" --status "$status" ${note:+--note "$note$($jq -r '.structured_output | "\(.considered) distinct stories judged; \(.items|length) survived, \(.overflow|length) kept for the feed."' "$work/triage.json")"}
rc=$?
# Pictures for the feed: fills each item's image from its story page. Its
# failures stay in the transcript and never change the run's exit.
feed_file=$feed_dir/$date-watch.json
enrich=skipped
if [ "$rc" = 0 ] && [ -f "$feed_file" ]; then
    run_limited "$enrich_seconds" "$python3" "$root/feed/bin/enrich" "$feed_file" 2>"$work/enrich.err"; enrich=$?
fi
/bin/chmod -R go-rwx "$work"
n_items=$($jq '.structured_output.items | length' "$work/triage.json")
log "exit=$rc date=$date since=$since threads=$n_threads extracted=$ok failed=$failed stories=$n_stories items=$n_items enrich=$enrich"
exit "$rc"
