#!/usr/bin/env node

import fs from 'node:fs';
import fsp from 'node:fs/promises';
import http from 'node:http';
import net from 'node:net';
import os from 'node:os';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

import { TIMEOUTS } from '../lib/config.mjs';
import { layoutPaths } from '../lib/layout.mjs';
import { renderPlist, validatePlistInputs } from '../lib/launchd.mjs';

const LABEL = 'com.personal-assistant.dashboard';
const APP_DIR = path.resolve(fileURLToPath(new URL('..', import.meta.url)));
const START_PATH = path.join(APP_DIR, 'bin', 'dashboard-start');
const DEFAULT_PORT = 4243;
const HEALTH_TIMEOUT_MS = 10_000;
// A stopping dashboard drains persona turns (drainMs), aborts the rest
// (abortGraceMs), closes its server (shutdownMs), and forces its exit one
// second later; the extra 2 seconds cover the process going away.
const UNLOAD_TIMEOUT_MS = TIMEOUTS.drainMs + TIMEOUTS.abortGraceMs + TIMEOUTS.shutdownMs + 1_000 + 2_000;
const STATE_TIMEOUT_MS = 5_000;
const API_KEY_VARS = ['ANTHROPIC_API_KEY', 'OPENAI_API_KEY'];
const ACTIVE_STATES = new Set(['busy', 'waiting']);
const BOOTSTRAP_RETRIES = 3;
const BOOTSTRAP_RETRY_DELAY_MS = 1_000;
// launchctl bootstrap returns 5 (Input/output error) or 37 (Operation already
// in progress) while a just-booted-out instance is still exiting.
const RETRYABLE_BOOTSTRAP_CODES = new Set([5, 37]);
// Tests run the real install path against a temporary HOME and a fake
// launchctl; nothing else should set this.
const ALLOW_HOME_OVERRIDE = process.env.DASHBOARD_INSTALL_ALLOW_HOME_OVERRIDE === '1';

async function main() {
  const options = parseArgs(process.argv.slice(2));
  refuseApiKeys();
  const nodePath = options.nodePath ?? process.execPath;

  if (!options.dryRun && !options.publicOrigin) {
    throw new Error('--public-origin is required for installation');
  }

  const dataHome = resolveDataHome();
  const root = layoutPaths(dataHome);
  const inputs = validatePlistInputs({
    label: LABEL,
    nodePath,
    appDir: APP_DIR,
    home: dataHome,
    exportHome: !isUnset(process.env.PERSONAL_ASSISTANT_HOME),
    port: options.port,
    publicOrigin: options.publicOrigin,
  });
  verifyNode(inputs.nodePath);
  verifyStartScript(START_PATH);

  let homeDir;
  if (!options.dryRun) homeDir = resolveHome();

  // The rendered plist and its backups are rebuildable, so they sit in the
  // data root's cache; the root itself is private.
  const stagingDir = path.join(root.cacheDir, 'launchd');
  const renderedPath = path.join(stagingDir, `${LABEL}.plist`);
  await fsp.mkdir(dataHome, { recursive: true, mode: 0o700 });
  await fsp.mkdir(stagingDir, { recursive: true, mode: 0o700 });
  await fsp.writeFile(renderedPath, renderPlist(inputs), { mode: 0o600 });
  await fsp.chmod(renderedPath, 0o600);
  lintPlist(renderedPath);

  if (options.dryRun) {
    console.log(renderedPath);
    return;
  }

  const launchAgentsDir = path.join(homeDir, 'Library', 'LaunchAgents');
  const installedPath = path.join(launchAgentsDir, `${LABEL}.plist`);
  const logDir = root.logDir;
  const backupPath = path.join(stagingDir, `backup-${new Date().toISOString().replaceAll(/[:.]/g, '-')}.plist`);
  const hadExistingPlist = fs.existsSync(installedPath);

  await fsp.mkdir(logDir, { recursive: true, mode: 0o700 });
  await fsp.chmod(logDir, 0o700);
  await fsp.mkdir(launchAgentsDir, { recursive: true, mode: 0o700 });
  if (hadExistingPlist) {
    await fsp.copyFile(installedPath, backupPath);
    await fsp.chmod(backupPath, 0o600);
  }

  const serviceTarget = `gui/${process.getuid()}/${LABEL}`;
  const domainTarget = `gui/${process.getuid()}`;
  const wasLoaded = isLoaded(serviceTarget);
  if (wasLoaded && !hadExistingPlist) {
    console.error(
      `dashboard-install: warning: ${LABEL} is loaded but ${installedPath} does not exist; ` +
      'if this install fails, the previous job cannot be restored automatically.',
    );
  }

  if (wasLoaded && !options.force) await refuseActivePersonas(previousPort(installedPath, inputs.port));

  // A failed bootout leaves the existing job and plist untouched, so there is
  // nothing to roll back until this succeeds (or confirms no job is loaded).
  if (wasLoaded) await bootoutAndWait(serviceTarget);

  const rollbackState = { serviceTarget, domainTarget, installedPath, backupPath, hadExistingPlist, wasLoaded };

  if (await portAnswers(inputs.port)) {
    const problems = await rollback(rollbackState);
    throw new Error(
      `another process is already listening on 127.0.0.1:${inputs.port}. ` +
      'Stop it (for example a manual npm start) and run the installer again. ' +
      `No new plist was written. ${describeRollback(problems, rollbackState)}`,
    );
  }

  try {
    await replaceFile(renderedPath, installedPath);
    await bootstrapWithRetry(domainTarget, installedPath);
    runLaunchctl(['kickstart', '-k', serviceTarget]);
    await waitForHealth(inputs.port, HEALTH_TIMEOUT_MS);
    confirmJobOwnsListener(serviceTarget, inputs.port);
  } catch (error) {
    const problems = await rollback(rollbackState);
    throw new Error(
      `the new dashboard job did not start: ${error.message}. ${describeRollback(problems, rollbackState)}`,
    );
  }

  console.log(`Installed ${LABEL} from ${installedPath}`);
  console.log(`Health check passed at http://127.0.0.1:${inputs.port}/healthz`);
  console.log(`The dashboard runs from the data root ${dataHome}; its log is ${path.join(logDir, 'dashboard.log')}.`);
  if (hadExistingPlist) console.log(`Previous plist saved at ${backupPath}`);
}

function parseArgs(args) {
  const options = { dryRun: false, force: false, port: DEFAULT_PORT };
  for (let index = 0; index < args.length; index += 1) {
    const argument = args[index];
    if (argument === '--dry-run') {
      options.dryRun = true;
      continue;
    }
    if (argument === '--force') {
      options.force = true;
      continue;
    }
    if (argument === '--public-origin') {
      options.publicOrigin = requiredValue(args, ++index, argument);
      continue;
    }
    if (argument === '--port') {
      const value = requiredValue(args, ++index, argument);
      options.port = /^\d+$/.test(value) ? Number(value) : Number.NaN;
      continue;
    }
    if (argument === '--node') {
      options.nodePath = requiredValue(args, ++index, argument);
      continue;
    }
    throw new Error(`unknown argument: ${argument}`);
  }
  return options;
}

function requiredValue(args, index, flag) {
  const value = args[index];
  if (value === undefined || value.startsWith('--')) throw new Error(`${flag} requires a value`);
  return value;
}

// Persona turns must bill the Claude subscription. The job does not inherit
// this shell's environment, but a key here is the sign of a setup that would
// hand one to it, so the installer stops before rendering anything.
function refuseApiKeys() {
  const present = API_KEY_VARS.filter((name) => process.env[name]);
  if (present.length > 0) {
    throw new Error(
      `${present.join(' and ')} ${present.length === 1 ? 'is' : 'are'} set in this environment. ` +
      'Persona turns must bill the Claude subscription, not an API key. Unset it and run the installer again.',
    );
  }
}

// The port the loaded job listens on: DASHBOARD_PORT from the installed
// plist, or `fallback` when there is no readable previous plist. A reinstall
// that changes the port must still ask the old dashboard, not the new port.
function previousPort(installedPath, fallback) {
  let plist;
  try {
    plist = fs.readFileSync(installedPath, 'utf8');
  } catch {
    return fallback;
  }
  const match = /<key>DASHBOARD_PORT<\/key>\s*<string>(\d{1,5})<\/string>/.exec(plist);
  const port = match ? Number(match[1]) : Number.NaN;
  return port >= 1 && port <= 65535 ? port : fallback;
}

// Asks the running dashboard for its state and refuses when any persona is
// busy or waiting on an answer, since unloading would cut those turns short
// after the drain. No answer means there is nothing to ask; the install goes on.
async function refuseActivePersonas(port) {
  const state = await fetchState(port);
  const active = (Array.isArray(state?.agents) ? state.agents : [])
    .filter((agent) => ACTIVE_STATES.has(agent?.state))
    .map((agent) => (typeof agent.name === 'string' ? agent.name : String(agent.id)));
  if (active.length > 0) {
    throw new Error(
      `persona turns are still running (${active.join(', ')}). ` +
      'Wait for them to finish, or run the installer again with --force to unload anyway.',
    );
  }
}

function fetchState(port) {
  return new Promise((resolve) => {
    const request = http.get({
      host: '127.0.0.1',
      port,
      path: '/api/state',
      timeout: STATE_TIMEOUT_MS,
    }, (response) => {
      const chunks = [];
      response.on('data', (chunk) => chunks.push(chunk));
      response.on('end', () => {
        if (response.statusCode !== 200) return resolve(null);
        try {
          resolve(JSON.parse(Buffer.concat(chunks).toString('utf8')));
        } catch {
          resolve(null);
        }
      });
      response.on('error', () => resolve(null));
    });
    request.on('timeout', () => request.destroy());
    request.on('error', () => resolve(null));
  });
}

// The data root: PERSONAL_ASSISTANT_HOME when set, which must be absolute,
// else .personal-assistant under HOME, as dashboard-start resolves it.
function resolveDataHome() {
  const value = process.env.PERSONAL_ASSISTANT_HOME;
  if (!isUnset(value)) {
    if (!path.isAbsolute(value)) throw new Error('PERSONAL_ASSISTANT_HOME must be an absolute path');
    return path.resolve(value);
  }
  const homeDir = process.env.HOME || os.homedir();
  if (!path.isAbsolute(homeDir)) throw new Error('HOME must be an absolute path');
  return path.join(homeDir, '.personal-assistant');
}

function isUnset(value) {
  return value === undefined || value === '';
}

function resolveHome() {
  const homeDir = process.env.HOME || os.homedir();
  if (!path.isAbsolute(homeDir)) throw new Error('HOME must be an absolute path');
  const accountHome = os.userInfo().homedir;
  if (!ALLOW_HOME_OVERRIDE && path.resolve(homeDir) !== path.resolve(accountHome)) {
    throw new Error(
      `HOME (${homeDir}) differs from this account's home directory (${accountHome}); ` +
      'refusing to install a LaunchAgent there',
    );
  }
  return homeDir;
}

function verifyNode(nodePath) {
  try {
    fs.accessSync(nodePath, fs.constants.X_OK);
  } catch {
    throw new Error(`Node executable is not executable: ${nodePath}`);
  }

  const result = spawnSync(nodePath, ['--version'], { encoding: 'utf8' });
  if (result.error) throw new Error(`could not run Node executable: ${result.error.message}`);
  if (result.status !== 0) throw new Error(`Node executable exited with status ${result.status}`);
  const match = /^v(\d+)\./.exec(result.stdout.trim());
  if (!match || Number(match[1]) < 24) {
    throw new Error(`Node 24 or newer is required; found ${result.stdout.trim() || 'unknown version'}`);
  }
}

function verifyStartScript(startPath) {
  try {
    fs.accessSync(startPath, fs.constants.X_OK);
  } catch {
    throw new Error(`start script is missing or not executable: ${startPath}`);
  }
}

function lintPlist(plistPath) {
  const result = spawnSync('plutil', ['-lint', plistPath], { encoding: 'utf8' });
  if (result.error) throw new Error(`could not run plutil: ${result.error.message}`);
  if (result.status !== 0) {
    const detail = result.stderr.trim() || result.stdout.trim() || `exit status ${result.status}`;
    throw new Error(`plist validation failed: ${detail}`);
  }
}

function launchctl(args) {
  const result = spawnSync('launchctl', args, { encoding: 'utf8' });
  if (result.error) throw new Error(`could not run launchctl: ${result.error.message}`);
  return result;
}

function describeFailure(result) {
  return result.stderr.trim() || result.stdout.trim() || `exit status ${result.status}`;
}

function runLaunchctl(args) {
  const result = launchctl(args);
  if (result.status !== 0) throw new Error(`launchctl ${args[0]} failed: ${describeFailure(result)}`);
  return result;
}

function isLoaded(serviceTarget) {
  return launchctl(['print', serviceTarget]).status === 0;
}

async function bootoutAndWait(serviceTarget) {
  const result = launchctl(['bootout', serviceTarget]);
  if (result.status !== 0) {
    const detail = `${result.stderr}\n${result.stdout}`;
    if (!/no such process|could not find service|service not found|not loaded/i.test(detail)) {
      throw new Error(`launchctl bootout failed: ${describeFailure(result)}`);
    }
  }

  const deadline = Date.now() + UNLOAD_TIMEOUT_MS;
  while (isLoaded(serviceTarget)) {
    if (Date.now() >= deadline) {
      throw new Error(`${serviceTarget} was still loaded ${UNLOAD_TIMEOUT_MS / 1_000} seconds after bootout`);
    }
    await delay(250);
  }
}

async function bootstrapWithRetry(domainTarget, plistPath) {
  for (let attempt = 0; ; attempt += 1) {
    const result = launchctl(['bootstrap', domainTarget, plistPath]);
    if (result.status === 0) return;
    if (!RETRYABLE_BOOTSTRAP_CODES.has(result.status) || attempt >= BOOTSTRAP_RETRIES) {
      throw new Error(`launchctl bootstrap failed: ${describeFailure(result)}`);
    }
    await delay(BOOTSTRAP_RETRY_DELAY_MS);
  }
}

function confirmJobOwnsListener(serviceTarget, port) {
  const printed = runLaunchctl(['print', serviceTarget]).stdout;
  if (!/^\s*state = running\s*$/m.test(printed)) {
    throw new Error(`${serviceTarget} is not in the running state after the health check`);
  }
  const pidMatch = /^\s*pid = (\d+)\s*$/m.exec(printed);
  if (!pidMatch) throw new Error(`launchctl print did not report a pid for ${serviceTarget}`);
  const jobPid = pidMatch[1];

  const lsof = spawnSync('lsof', ['-nP', `-iTCP:${port}`, '-sTCP:LISTEN', '-t'], { encoding: 'utf8' });
  if (lsof.error) throw new Error(`could not run lsof: ${lsof.error.message}`);
  const listenerPids = [...new Set(lsof.stdout.split('\n').map((line) => line.trim()).filter(Boolean))];
  if (listenerPids.length !== 1 || listenerPids[0] !== jobPid) {
    throw new Error(
      `port ${port} is held by pid ${listenerPids.join(', ') || 'none'}, not by the job's pid ${jobPid}`,
    );
  }
}

async function replaceFile(sourcePath, destinationPath) {
  const temporaryPath = `${destinationPath}.tmp-${process.pid}`;
  try {
    await fsp.copyFile(sourcePath, temporaryPath);
    await fsp.chmod(temporaryPath, 0o644);
    await fsp.rename(temporaryPath, destinationPath);
  } finally {
    await fsp.rm(temporaryPath, { force: true });
  }
}

// Returns the list of problems met while putting back the plist file and the
// loaded/unloaded state recorded before the installer's first bootout.
async function rollback({ serviceTarget, domainTarget, installedPath, backupPath, hadExistingPlist, wasLoaded }) {
  const problems = [];
  try {
    if (isLoaded(serviceTarget)) await bootoutAndWait(serviceTarget);
  } catch (error) {
    problems.push(error.message);
    return problems;
  }

  try {
    if (hadExistingPlist) {
      await replaceFile(backupPath, installedPath);
      if (wasLoaded) await bootstrapWithRetry(domainTarget, installedPath);
    } else {
      await fsp.rm(installedPath, { force: true });
    }
  } catch (error) {
    problems.push(`could not restore the previous job: ${error.message}`);
  }
  return problems;
}

function describeRollback(problems, { hadExistingPlist, wasLoaded, installedPath }) {
  if (problems.length > 0) return `Rollback also reported: ${problems.join('; ')}`;
  if (hadExistingPlist && wasLoaded) return 'The previous plist was restored and its job loaded again.';
  if (hadExistingPlist) return 'The previous plist was restored; it was not loaded before, so it was left unloaded.';
  if (wasLoaded) {
    return `The previous job was loaded without a plist at ${installedPath}, so it could not be restored.`;
  }
  return 'No previous job was installed; nothing was left loaded.';
}

function portAnswers(port) {
  return new Promise((resolve) => {
    const socket = net.connect({ host: '127.0.0.1', port });
    socket.setTimeout(1_000);
    socket.once('connect', () => {
      socket.destroy();
      resolve(true);
    });
    socket.once('timeout', () => {
      socket.destroy();
      resolve(false);
    });
    socket.once('error', () => resolve(false));
  });
}

async function waitForHealth(port, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    if (await healthIsReady(port)) return;
    await delay(250);
  }
  throw new Error(`health check timed out after ${timeoutMs / 1_000} seconds`);
}

function healthIsReady(port) {
  return new Promise((resolve) => {
    const request = http.get({
      host: '127.0.0.1',
      port,
      path: '/healthz',
      timeout: 500,
    }, (response) => {
      response.resume();
      resolve(response.statusCode === 200);
    });
    request.on('timeout', () => request.destroy());
    request.on('error', () => resolve(false));
  });
}

function delay(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

main().catch((error) => {
  console.error(`dashboard-install: ${error.message}`);
  process.exitCode = 1;
});
