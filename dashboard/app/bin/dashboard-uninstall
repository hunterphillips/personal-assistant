#!/usr/bin/env node

import fsp from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

import { jobRunnerFrom } from '../lib/config.mjs';

const LABEL = 'com.personal-assistant.dashboard';

async function main() {
  const homeDir = process.env.HOME || os.homedir();
  if (!path.isAbsolute(homeDir)) throw new Error('HOME must be an absolute path');
  if (jobRunnerFrom() === 'systemd') {
    await uninstallUnit(homeDir);
    return;
  }

  const launchAgentsDir = path.join(homeDir, 'Library', 'LaunchAgents');
  const expectedPlistPath = path.join(launchAgentsDir, `${LABEL}.plist`);
  const options = parseArgs(process.argv.slice(2), expectedPlistPath);

  if (options.label !== LABEL) {
    throw new Error(`refusing to operate on label ${options.label}; only ${LABEL} is allowed`);
  }
  if (path.resolve(options.plistPath) !== expectedPlistPath) {
    throw new Error(`refusing to remove plist outside the expected path: ${expectedPlistPath}`);
  }

  bootoutIfLoaded(`gui/${process.getuid()}/${LABEL}`);
  await fsp.rm(expectedPlistPath, { force: true });
  console.log(`Uninstalled ${LABEL}`);
  console.log('The source files and the data root were preserved.');
}

async function uninstallUnit(homeDir) {
  const options = parseArgs(process.argv.slice(2));
  if (options.label !== LABEL) {
    throw new Error(`refusing to operate on label ${options.label}; only ${LABEL} is allowed`);
  }
  const unitPath = path.join(homeDir, '.config', 'systemd', 'user', `${LABEL}.service`);
  disableIfInstalled();
  await fsp.rm(unitPath, { force: true });
  systemctl(['daemon-reload']);
  console.log(`Uninstalled ${LABEL}`);
  console.log('The source files and the data root were preserved.');
}

// --plist names the launchd path only; the systemd path takes --label alone.
function parseArgs(args, defaultPlistPath) {
  const options = { label: LABEL, plistPath: defaultPlistPath };
  for (let index = 0; index < args.length; index += 1) {
    const argument = args[index];
    if (argument === '--label') {
      options.label = requiredValue(args, ++index, argument);
      continue;
    }
    if (argument === '--plist' && defaultPlistPath !== undefined) {
      options.plistPath = requiredValue(args, ++index, argument);
      continue;
    }
    throw new Error(`unknown argument: ${argument}`);
  }
  return options;
}

function requiredValue(args, index, flag) {
  const value = args[index];
  if (value === undefined || value.startsWith('--')) throw new Error(`${flag} requires a value`);
  return value;
}

function bootoutIfLoaded(serviceTarget) {
  const result = spawnSync('launchctl', ['bootout', serviceTarget], { encoding: 'utf8' });
  if (result.error) throw new Error(`could not run launchctl: ${result.error.message}`);
  if (result.status === 0) return;
  const detail = `${result.stderr}\n${result.stdout}`;
  if (/no such process|could not find service|service not found/i.test(detail)) return;
  throw new Error(`launchctl bootout failed: ${detail.trim() || `exit status ${result.status}`}`);
}

function systemctl(args) {
  const result = spawnSync('systemctl', ['--user', ...args], { encoding: 'utf8' });
  if (result.error) throw new Error(`could not run systemctl: ${result.error.message}`);
  if (result.status !== 0) {
    const detail = result.stderr.trim() || result.stdout.trim() || `exit status ${result.status}`;
    throw new Error(`systemctl ${args[0]} failed: ${detail}`);
  }
}

// Without a unit file disable has nothing to act on, but a service loaded
// before the file went away may still run, so it is stopped by name.
function disableIfInstalled() {
  const notInstalled = /does not exist|not loaded|not found/i;
  try {
    systemctl(['disable', '--now', LABEL]);
  } catch (error) {
    if (!notInstalled.test(error.message)) throw error;
    try {
      systemctl(['stop', LABEL]);
    } catch (stopError) {
      if (!notInstalled.test(stopError.message)) throw stopError;
    }
  }
}

main().catch((error) => {
  console.error(`dashboard-uninstall: ${error.message}`);
  process.exitCode = 1;
});
