[Unit]
Description=Personal assistant dashboard

[Service]
ExecStart={{START_PATH}} {{NODE_PATH}}
WorkingDirectory={{APP_DIR}}
Environment={{PATH_ENTRY}}
Environment="DASHBOARD_PORT={{PORT}}"
{{HOME_ENTRY}}{{PUBLIC_ORIGIN_ENTRY}}{{BRIEFS_DIR_ENTRY}}{{FOCUS_ORIGIN_ENTRY}}Restart=on-failure
StandardOutput=append:{{DATA_ROOT}}/log/dashboard.log
StandardError=append:{{DATA_ROOT}}/log/dashboard.log

[Install]
WantedBy=default.target
