#!/bin/sh
# Install or refresh the Daily Brief LaunchAgent: copies the plist into
# ~/Library/LaunchAgents and (re)loads it. Rerun after editing the plist.
set -eu
root=/Users/hunterphillips/workspace/personal-assistant
label=com.personal-assistant.daily-brief
src=$root/daily-brief/launchd/$label.plist
dst=$HOME/Library/LaunchAgents/$label.plist
uid_n=$(id -u)

plutil -lint "$src" >/dev/null
cp "$src" "$dst"
launchctl bootout "gui/$uid_n/$label" 2>/dev/null || true
launchctl bootstrap "gui/$uid_n" "$dst"
printf 'loaded %s\n' "$label"
launchctl list | grep "$label"
