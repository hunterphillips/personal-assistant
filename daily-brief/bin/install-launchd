#!/bin/sh
# Install or refresh every Daily Brief LaunchAgent in daily-brief/launchd/
# and the feeds job in feeds/launchd/: copies each plist into ~/Library/LaunchAgents and (re)loads it.
set -eu
root=/Users/hunterphillips/workspace/personal-assistant
uid_n=$(id -u)
for src in "$root"/daily-brief/launchd/com.personal-assistant.*.plist "$root"/feeds/launchd/com.personal-assistant.*.plist; do
    label=$(basename "$src" .plist)
    dst=$HOME/Library/LaunchAgents/$label.plist
    plutil -lint "$src" >/dev/null
    cp "$src" "$dst"
    launchctl bootout "gui/$uid_n/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$uid_n" "$dst"
    printf 'loaded %s\n' "$label"
done
launchctl list | grep com.personal-assistant
